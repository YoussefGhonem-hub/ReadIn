{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "readin-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush",
          "style": "css"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "rd",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "browser-image-compression.js",
                "input": "node_modules/browser-image-compression/dist",
                "output": "vendor"
              },
              {
                "glob": "*.svg",
                "input": "node_modules/flag-icons/flags/4x3",
                "output": "flags"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["localhost", "127.0.0.1", "readin.app", "*.readin.app"]
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "loader": {
              ".txt": "text"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "with": "src/environments/environment.development.ts",
                  "replace": "src/environments/environment.ts"
                },
                {
                  "with": "src/app/features/auth/dev/dev-login.development.ts",
                  "replace": "src/app/features/auth/dev/dev-login.ts"
                }
              ]
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "with": "src/environments/environment.e2e.ts",
                  "replace": "src/environments/environment.ts"
                },
                {
                  "with": "src/app/features/auth/dev/dev-login.development.ts",
                  "replace": "src/app/features/auth/dev/dev-login.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "readin-web:build:production"
            },
            "development": {
              "buildTarget": "readin-web:build:development"
            },
            "e2e": {
              "buildTarget": "readin-web:build:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "readin-web:build:development"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}

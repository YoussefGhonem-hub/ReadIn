    { "id": "code-short", "type": "code", "lang": "csharp", "filename": "Program.cs", "highlightLines": [2, 5],
      "code": "var builder = WebApplication.CreateBuilder(args);\nbuilder.Services.AddScoped<IOrderService, OrderService>();\nbuilder.Services.AddSingleton(TimeProvider.System);\n\nvar app = builder.Build();\napp.MapGet(\"/orders/{id}\", async (Guid id, IOrderService orders) => await orders.FindAsync(id));\n\n// تعليق بالعربي جوه الكود: الكود دايماً من الشمال لليمين\napp.MapPost(\"/orders\", async (CreateOrder body, IOrderService orders) => Results.Created($\"/orders/{body.Id}\", await orders.CreateAsync(body)));\n\napp.Run();\n// end of short code" },

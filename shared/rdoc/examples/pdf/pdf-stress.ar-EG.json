    { "id": "code-long", "type": "code", "lang": "csharp", "filename": "OrderService.cs",
      "code": "namespace Shop.Orders;\n\npublic sealed class OrderService(IOrderRepository orders, IClock clock, ILogger<OrderService> logger) : IOrderService\n{\n    public async Task<Order?> FindAsync(Guid id)\n    {\n        logger.LogInformation(\"Finding order {Id}\", id);\n        return await orders.FindAsync(id);\n    }\n\n    public async Task<Order> CreateAsync(CreateOrder command)\n    {\n        var order = new Order(command.Id, command.CustomerId, clock.UtcNow);\n        foreach (var line in command.Lines) order.AddLine(line.ProductId, line.Quantity, line.UnitPrice);\n        await orders.AddAsync(order);\n        return order;\n    }\n\n    public async Task CancelAsync(Guid id, string reason)\n    {\n        var order = await orders.FindAsync(id) ?? throw new InvalidOperationException($\"Order {id} was not found.\");\n        order.Cancel(reason, clock.UtcNow);\n        await orders.SaveAsync(order);\n    }\n\n    public async Task<IReadOnlyList<Order>> RecentAsync(int count)\n    {\n        var result = await orders.ListAsync(o => o.CreatedAt > clock.UtcNow.AddDays(-30), orderBy: o => o.CreatedAt, descending: true, take: count, includeLines: true, includeCustomer: true, includePayments: true, includeShipments: true, trackChanges: false, cancellationToken: CancellationToken.None);\n        return result;\n    }\n\n    public async Task<decimal> TotalAsync(Guid id)\n    {\n        var order = await orders.FindAsync(id);\n        return order?.Lines.Sum(l => l.Quantity * l.UnitPrice) ?? 0m;\n    }\n\n    public async Task ShipAsync(Guid id)\n    {\n        var order = await orders.FindAsync(id) ?? throw new InvalidOperationException(\"Not found\");\n        order.Ship(clock.UtcNow);\n        await orders.SaveAsync(order);\n    }\n\n    public async Task RefundAsync(Guid id, decimal amount)\n    {\n        var order = await orders.FindAsync(id) ?? throw new InvalidOperationException(\"Not found\");\n        order.Refund(amount, clock.UtcNow);\n        await orders.SaveAsync(order);\n    }\n}\n// LongCodeLastLine" },

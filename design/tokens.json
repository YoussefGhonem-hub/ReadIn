{
  "$description": "ReadIn design tokens — single source of truth. Run `node tools/tokens/build.mjs` to regenerate web/src/styles/tokens*.css and mobile/lib/core/theme/tokens.g.dart. Never hard-code colors in components (SPEC §15).",
  "$version": 1,

  "color": {
    "primary":              { "light": "#0F5E52", "dark": "#3FB8A3", "usage": "Buttons, links, logo, active states" },
    "on-primary":           { "light": "#FFFFFF", "dark": "#0B1F1B", "usage": "Text/icons on primary" },
    "primary-container":    { "light": "#E3F1EE", "dark": "#16302A", "usage": "Selected chips, soft backgrounds" },
    "on-primary-container": { "light": "#0A493F", "dark": "#BFE7DF", "usage": "Text on primary container" },
    "accent":               { "light": "#F2A93B", "dark": "#F5B95A", "usage": "Streaks, highlights, badges" },
    "on-accent":            { "light": "#1A1A1A", "dark": "#1A1A1A", "usage": "Text on accent" },
    "accent-container":     { "light": "#FFF3D9", "dark": "#3A2E17", "usage": "Streak badge background" },
    "bg":                   { "light": "#F4F2EE", "dark": "#121413", "usage": "App background (never pure black)" },
    "surface":              { "light": "#FFFFFF", "dark": "#1B1E1C", "usage": "Cards, sheets" },
    "surface-variant":      { "light": "#F3F0EA", "dark": "#202321", "usage": "Inputs, subtle fills, skeletons" },
    "surface-raised":       { "light": "#FFFFFF", "dark": "#232624", "usage": "Dialogs, menus" },
    "border":               { "light": "#E8E4DC", "dark": "#2E322F", "usage": "Dividers, outlines" },
    "text-primary":         { "light": "#1A1A1A", "dark": "#ECEAE6", "usage": "Main text" },
    "text-secondary":       { "light": "#6B6B6B", "dark": "#A3A39E", "usage": "Meta text" },
    "link":                 { "light": "#0F5E52", "dark": "#3FB8A3", "usage": "Inline links in articles" },
    "focus-ring":           { "light": "#0F5E52", "dark": "#3FB8A3", "usage": "Keyboard focus outline" },
    "highlight":            { "light": "#FFF0C2", "dark": "#4A3B12", "usage": "Highlight mark in RDoc" },
    "scrim":                { "light": "#1A1A1A66", "dark": "#00000099", "usage": "Modal/bottom sheet backdrop" },

    "callout-tip":          { "light": "#E8F3EF", "dark": "#16302A", "usage": "Tip callout background" },
    "callout-tip-accent":   { "light": "#0F5E52", "dark": "#3FB8A3", "usage": "Tip callout stripe/icon" },
    "callout-info":         { "light": "#EEF1F5", "dark": "#1E2530", "usage": "Info callout background" },
    "callout-info-accent":  { "light": "#3B6EA5", "dark": "#8DB3E2", "usage": "Info callout stripe/icon" },
    "callout-warning":      { "light": "#FDF3E1", "dark": "#3A2E17", "usage": "Warning callout background" },
    "callout-warning-accent": { "light": "#A86400", "dark": "#F5B95A", "usage": "Warning callout stripe/icon" },
    "callout-danger":       { "light": "#FBEAEA", "dark": "#3A1E1E", "usage": "Danger callout background" },
    "callout-danger-accent": { "light": "#C0392B", "dark": "#E5675A", "usage": "Danger callout stripe/icon" },

    "code-bg":              { "light": "#1E2321", "dark": "#0E100F", "usage": "Code blocks (dark in both modes)" },
    "code-text":            { "light": "#E6E6E1", "dark": "#E6E6E1", "usage": "Code block default text" },
    "code-border":          { "light": "#1E2321", "dark": "#2E322F", "usage": "Code block border" },

    "success":              { "light": "#2E7D5B", "dark": "#5CC594", "usage": "Success states" },
    "error":                { "light": "#C0392B", "dark": "#E5675A", "usage": "Error states" },
    "on-error":             { "light": "#FFFFFF", "dark": "#1A1A1A", "usage": "Text on error" }
  },

  "font": {
    "family": {
      "arabic": "IBM Plex Sans Arabic",
      "latin": "IBM Plex Sans",
      "mono": "JetBrains Mono"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },

  "typography": {
    "caption":  { "size": 12, "lineHeight": 1.4, "weight": 500 },
    "meta":     { "size": 13, "lineHeight": 1.45, "weight": 400 },
    "ui":       { "size": 15, "lineHeight": 1.5, "weight": 400 },
    "ui-lg":    { "size": 16, "lineHeight": 1.5, "weight": 500 },
    "body":     { "size": 18, "lineHeight": 1.8, "weight": 400 },
    "h3":       { "size": 22, "lineHeight": 1.4, "weight": 600 },
    "h2":       { "size": 28, "lineHeight": 1.3, "weight": 600 },
    "h1":       { "size": 32, "lineHeight": 1.25, "weight": 600 },
    "code":     { "size": 14, "lineHeight": 1.6, "weight": 400 }
  },

  "articleFontScale": { "s": 16, "m": 18, "l": 20, "xl": 22 },

  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 40, "8": 48, "9": 64 },

  "radius": { "sm": 8, "md": 12, "card": 16, "sheet": 24, "chip": 999 },

  "elevation": {
    "card":   { "light": "0 2px 8px rgba(43, 38, 27, .07), 0 8px 24px rgba(43, 38, 27, .06)", "dark": "none" },
    "raised": { "light": "0 18px 55px rgba(43, 38, 27, .12), 0 2px 8px rgba(43, 38, 27, .07)", "dark": "none" }
  },

  "motion": { "fast": 120, "base": 200, "slow": 320 },

  "layout": { "readingWidth": 720, "contentMaxWidth": 1200, "sideNavWidth": 248, "bottomNavHeight": 64 }
}

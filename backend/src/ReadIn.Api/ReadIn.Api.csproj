<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ReadIn.Api</RootNamespace>
    <UserSecretsId>readin-api-6b1d2c4e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReadIn.Application\ReadIn.Application.csproj" />
    <ProjectReference Include="..\ReadIn.Infrastructure\ReadIn.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReadIn.Api.IntegrationTests" />
  </ItemGroup>

  <!-- User uploads live on the server, not in the build: a deploy must never ship or overwrite them (ADR 0010). -->
  <ItemGroup>
    <Content Update="wwwroot\uploads\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Private files (verification proofs, SPEC F19) are personal documents: never part of a build or a deploy. -->
  <ItemGroup>
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

</Project>

{
  "ConnectionStrings": {
    "ReadIn": ""
  },
  "Firebase": {
    "ProjectId": "",
    "UseEmulator": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "RunOnStartup": false
  },
  "Hangfire": {
    "Enabled": true
  },
  "Cors": {
    "Origins": [ "https://readin.app" ]
  },
  "Storage": {
    "UploadsPath": "wwwroot/uploads",
    "PublicBaseUrl": "https://api.readin.app"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}

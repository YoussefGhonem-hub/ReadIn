{
  "ConnectionStrings": {
    "ReadIn": ""
  },
  "Firebase": {
    "ProjectId": "",
    "UseEmulator": false,
    "DatabaseUrl": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "RunOnStartup": false
  },
  "Hangfire": {
    "Enabled": true
  },
  "Cors": {
    "Origins": [ "https://readin.app" ]
  },
  "Storage": {
    "UploadsPath": "wwwroot/uploads",
    "PublicBaseUrl": "https://api.readin.app"
  },
  "Media": {
    "MaxUploadsPerDay": 50,
    "MaxStoredBytesPerUser": 209715200,
    "MaxDocumentPages": 100,
    "DocumentJobTimeout": "00:02:00",
    "MaxConcurrentDocumentJobs": 2,
    "FeedDocumentPages": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ReadIn.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReadIn.Domain\ReadIn.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mapster" />
    <PackageReference Include="Mapster.DependencyInjection" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="libphonenumber-csharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth for the RDoc contract, shared with web + mobile (SPEC §13). -->
    <EmbeddedResource Include="..\..\..\shared\rdoc\rdoc.schema.json" LogicalName="ReadIn.rdoc.schema.json" Link="Common\Content\rdoc.schema.json" />
    <!-- Common passwords rejected at sign up (SPEC §9.4); the clients use the same list. -->
    <EmbeddedResource Include="..\..\..\shared\security\common-passwords.txt" LogicalName="ReadIn.common-passwords.txt" Link="Common\Security\common-passwords.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReadIn.Application.UnitTests" />
    <InternalsVisibleTo Include="ReadIn.Api.IntegrationTests" />
    <InternalsVisibleTo Include="ReadIn.ArchitectureTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>

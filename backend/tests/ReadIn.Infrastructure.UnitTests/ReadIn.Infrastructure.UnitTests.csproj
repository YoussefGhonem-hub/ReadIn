<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReadIn.Infrastructure\ReadIn.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Media fixtures (ADR 0011): real JPEG/PNG/WebP/HEIC images and normal, encrypted, corrupted and 101-page PDFs. -->
    <None Include="../fixtures/media/**/*" LinkBase="fixtures/media" CopyToOutputDirectory="PreserveNewest" />
    <!-- Article PDF (SPEC F33, §27): the shared stress fixtures, the shared BiDi samples and the page baselines. -->
    <None Include="../../../shared/rdoc/examples/pdf/*.json" LinkBase="fixtures/rdoc-pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../shared/bidi/fixtures.json" Link="fixtures/bidi/fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Pdf/baselines/*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Quote cards (SPEC F24): the approved images, one Arabic light square and one English dark landscape. -->
    <None Update="QuoteCards/baselines/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
